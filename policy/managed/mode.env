AUROS_MODE=managed
AUROS_MODE_RANK=2
AUROS_MODE_TITLE="Managed"
AUROS_MODE_ONELINE="Anyone can use it. Changing it asks for the IT password, at the machine."

# ── What this mode claims, for checks B1 and B12. See open/mode.env for the vocabulary. ─────────
#
# Everything is still reachable through the GUI; the machine asks for the IT password first.
# 00-auros-managed.rules returns AUTH_ADMIN (not NO) for the package, network and systemd prefixes,
# and managed/kdeglobals/20-control-module-restrictions.ini hides only the panels polkit would
# refuse outright anyway -- kcm_networkmanagement and kcm_regionandlang are deliberately NOT hidden.
# So a password is not a terminal, and managed passes B12 on all four tasks.
AUROS_MODE_B1=login-prompt
AUROS_MODE_B12_INSTALL_APP=admin
AUROS_MODE_B12_WIFI=admin
AUROS_MODE_B12_PRINTER=seat
AUROS_MODE_B12_LANGUAGE=seat
# Users page (kcm_users), owner decision A4: shown only to aurosadmin members (root/etc/kde5rc +
# the plasma-workspace env script); a pupil gets no page and polkit refuses them. B12 checks whichever
# of the two the session's user is.
AUROS_MODE_B12_USERS=aurosadmin
AUROS_MODE_B12_DESKTOP=yes
