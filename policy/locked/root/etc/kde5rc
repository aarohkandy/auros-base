# Auros policy (managed/locked): the Users page (kcm_users) is hidden from everyone who is not in
# aurosadmin. Owner decision A4, control repo docs/ACCOUNTS.md §3.
#
# Why this file and not /etc/xdg/kdeglobals with the other hidden pages: KConfig reads /etc/kde5rc
# first for every KDE program (kconfig.cpp, literal name in KF6 — D25) unless KDE_SKIP_KDERC is set in
# the environment, and /etc/xdg/plasma-workspace/env/50-auros-admin-users-page.sh sets it only for an
# aurosadmin member's session. Hidden is the default; shown is the exception.
#
# `[$i]` on the KEY, not the group: a group marked immutable here would lock the whole
# [KDE Control Module Restrictions] group before /etc/xdg/kdeglobals could add its own pages to it.
#
# This is what the menu shows, not the lock. The lock is polkit: org.freedesktop.accounts.* is
# AUTH_ADMIN (managed) or NO (locked) for anyone outside aurosadmin (rules.d/00-auros-*.rules), so a
# pupil who un-hides the page in their own session still cannot change any account with it.
[KDE Control Module Restrictions]
kcm_users[$i]=false
