AUROS_MODE=locked
AUROS_MODE_RANK=3
AUROS_MODE_TITLE="Locked"
AUROS_MODE_ONELINE="A full desktop that cannot be changed from the seat. Changes arrive as a new image."

# ── What this mode claims, for checks B1 and B12. See open/mode.env for the vocabulary. ─────────
#
# THIS IS THE DECLARATION THAT MAKES `locked` PUBLISHABLE, and it is worth saying why plainly.
#
# B12 as written in checks.yaml requires that installing an application, joining Wi-Fi, adding a
# printer and changing the language are each reachable from the GUI. `locked` makes three of those
# four impossible BY CONSTRUCTION and says so to the customer in description.md:
#   * 00-auros-locked.rules denies the whole org.freedesktop.NetworkManager.,
#     org.freedesktop.Flatpak., org.freedesktop.packagekit. and org.freedesktop.locale1. prefixes
#   * 20-control-module-restrictions.ini sets kcm_networkmanagement=false and kcm_regionandlang=false
# Evaluating B12 against `open`'s list would fail a locked image for doing exactly what was ordered,
# and a recipe that cannot be published is worse than one that fails.
#
# So for `locked`, B12 asserts the OPPOSITE property on those three: the GUI must NOT offer them.
# That is a check that can genuinely go red -- it fails if the restriction leaks and the machine
# offers a door it will then slam, and it fails if the restriction quietly stops being applied. It
# is also the only runtime check that would notice build/40-windows-feel.sh overwriting
# /etc/xdg/kdeglobals after apply-policy merged the KDE Control Module Restrictions into it.
#
# Adding a printer stays `seat`: a locked classroom machine that cannot print is a machine the
# school stops using, and nothing in the mode restricts CUPS.
AUROS_MODE_B1=login-prompt
AUROS_MODE_B12_INSTALL_APP=none
AUROS_MODE_B12_WIFI=none
AUROS_MODE_B12_PRINTER=seat
AUROS_MODE_B12_LANGUAGE=none
# Users page (kcm_users), owner decision A4: shown only to aurosadmin members (root/etc/kde5rc +
# the plasma-workspace env script); a pupil gets no page and polkit refuses them. B12 checks whichever
# of the two the session's user is.
AUROS_MODE_B12_USERS=aurosadmin
AUROS_MODE_B12_DESKTOP=yes
