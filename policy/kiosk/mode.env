AUROS_MODE=kiosk
AUROS_MODE_RANK=4
AUROS_MODE_TITLE="Kiosk"
AUROS_MODE_ONELINE="One application, full screen, from power-on. There is no desktop on the machine."

# ── What this mode claims, for checks B1 and B12. See open/mode.env for the vocabulary. ─────────
#
# Kiosk has no login prompt and no desktop -- that is the product, not a gap. B1's "display manager
# active / greeter detected" is unsatisfiable here by design; the equivalent property, and the one
# kiosk/assert.sh already asserts, is that auros-kiosk.service is active and the recorded compositor
# is running as the auroskiosk account.
#
# B12's four tasks are not claimed at all: there is no session to reach a GUI from, which is also
# why there is no terminal to reach. assert-zero-terminal evaluates the kiosk criterion instead --
# the application is up and no GUI path to anything else exists on the image.
AUROS_MODE_B1=kiosk-session
AUROS_MODE_B12_INSTALL_APP=n/a
AUROS_MODE_B12_WIFI=n/a
AUROS_MODE_B12_PRINTER=n/a
AUROS_MODE_B12_LANGUAGE=n/a
# No desktop, so no Users page.
AUROS_MODE_B12_USERS=n/a
AUROS_MODE_B12_DESKTOP=no
