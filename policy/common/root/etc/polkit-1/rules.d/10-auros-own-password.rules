/* ---------------------------------------------------------------------------------------------
 * Auros policy, every mode: a person signed in at this machine may choose their OWN password.
 * Owner decisions (control repo docs/ACCOUNTS.md §5): the first sign-in asks every account to choose
 * its own password (desktop/welcome/auros-choose-password), and on `locked` that is the ONE account
 * change a pupil may make.
 *
 * org.freedesktop.accounts.change-own-password is accountsservice's action for SetPassword and
 * SetPasswordMode when the CALLER's uid is the target user's uid; any other target is
 * org.freedesktop.accounts.user-administration (accountsservice src/user.c, user_set_password). Its
 * upstream default is auth_admin (data/org.freedesktop.accounts.policy.in), so without this file a
 * pupil would need the IT password to choose their own. KDE's Users page calls exactly that
 * SetPassword (plasma-workspace kcms/users/src/user.cpp, User::setPassword).
 *
 * Only for a subject in an active local session: a person at the seat. A service account with no
 * session keeps the upstream answer, so a compromised daemon cannot give itself a password.
 *
 * 10-, after the modes' 00-auros-<mode>.rules: kiosk still refuses it (nobody signs in there), and
 * locked/managed hand it on by leaving it out of their guarded set.
 * ------------------------------------------------------------------------------------------------ */
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.accounts.change-own-password" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
