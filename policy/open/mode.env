AUROS_MODE=open
AUROS_MODE_RANK=1
AUROS_MODE_TITLE="Open"
AUROS_MODE_ONELINE="A normal computer. The person using it is its administrator."

# ── WHAT THIS MODE CLAIMS, in the vocabulary the check matrix uses ──────────────────────────────
#
# Checks B1 ("reaches a login prompt") and B12 ("zero-terminal audit") are written in checks.yaml
# against what an `open` image does, because the base is an `open` image. Three of the four modes
# deliberately do something else, and a check evaluated against the wrong mode's promises is either
# a mode that can never be published or a promise nobody verified. Neither is acceptable, so each
# mode declares its own criteria here, machine-readably, and apply-policy copies the active mode's
# declaration to /usr/lib/auros/policy/claims.env for the runtime checks to read.
#
#   AUROS_MODE_B1        login-prompt   a display manager / greeter appears within B1's window
#                        kiosk-session  there is no greeter; auros-kiosk.service and the application
#                                       process are running instead
#
#   AUROS_MODE_B12_*     seat   any user at the machine can do it through the GUI, no password
#                        admin  the GUI offers it and asks for the administrator password. Still
#                               zero-terminal: D4 forbids needing a command line, not needing a
#                               credential
#                        none   deliberately unavailable at the seat in this mode. B12 then asserts
#                               that the GUI does NOT offer it -- a door the machine offers and then
#                               slams is how a managed desktop starts feeling broken
#                        n/a    there is no desktop session on this machine
AUROS_MODE_B1=login-prompt
AUROS_MODE_B12_INSTALL_APP=seat
AUROS_MODE_B12_WIFI=seat
AUROS_MODE_B12_PRINTER=seat
AUROS_MODE_B12_LANGUAGE=seat
AUROS_MODE_B12_DESKTOP=yes
