#!/usr/bin/bash
# apply-policy -- activate one Auros policy mode on the image being built.
#
#   /usr/libexec/auros/apply-policy <open|managed|locked|kiosk>
#
# Runs at IMAGE BUILD TIME, not at boot. Two callers:
#
#   1. auros-base/build/20-policy.sh, which installs this payload and then activates the base's own
#      mode (`open` -- the base is not a customer image and must still satisfy B1 and B12 literally).
#
#   2. A customer recipe's own build layer, as a single line:
#          RUN /usr/libexec/auros/apply-policy locked
#      This is the "declarative and switchable per-recipe" half of spec 6A. There is still exactly
#      one base image; the mode is chosen in the derived layer, which is the only place it can be
#      chosen without turning four modes into four bases.
#
# Environment:
#   AUROS_ADMIN_USERS   space-separated accounts to add to the aurosadmin group
#   AUROS_KIOSK_EXEC    required for kiosk unless /etc/auros/kiosk.conf already supplies KIOSK_EXEC
#   AUROS_POLICY_PAYLOAD  override the payload directory (default /usr/share/auros/policy)
set -euo pipefail

PAYLOAD=${AUROS_POLICY_PAYLOAD:-/usr/share/auros/policy}
# shellcheck source=/dev/null
. "$PAYLOAD/lib/policy-lib.sh"

MODE="${1:-}"
case "$MODE" in
    open|managed|locked|kiosk) ;;
    *) die "usage: apply-policy <open|managed|locked|kiosk> (got '${MODE:-nothing}')" ;;
esac

SRC="$PAYLOAD/$MODE"
[ -d "$SRC" ] || die "no payload for mode '$MODE' at $SRC"
# shellcheck source=/dev/null
. "$SRC/mode.env"

# Recommends: is how a removed package comes back on the NEXT transaction -- including one in a
# customer recipe's own layer. Done here rather than only in 20-policy.sh so that a recipe calling
# apply-policy directly gets it as well.
auros_disable_weak_deps

install -d -m 0755 "$AUROS_POLICY_STATE"
# Ensure the file exists WITHOUT truncating it: auros_unmask_previous below has to read the list
# the previous mode wrote, and it truncates the file itself once it has. Truncating here instead
# would leave every unit the previous mode masked still masked -- a mode switch that releases the
# files and silently keeps the masks.
[ -f "$AUROS_MASKED_UNITS" ] || install -m 0644 /dev/null "$AUROS_MASKED_UNITS"

PREV="none"
[ -r "$AUROS_MODE_STAMP" ] && PREV="$(cat "$AUROS_MODE_STAMP")"

log "================================================================"
log "applying policy mode: $MODE ($AUROS_MODE_TITLE)"
log "  $AUROS_MODE_ONELINE"
log "  previous mode on this image: $PREV"
log "================================================================"

# ── the one switch that is not reversible, and why we refuse it rather than pretend ──────────────
# kiosk DELETES packages. Nothing in a later layer can bring them back, because the layer below no
# longer contains them. Activating a less restrictive mode on top of a kiosk image would produce an
# image whose stamp says "open" and which has no desktop in it -- a lie told by a file.
if [ "$PREV" = "kiosk" ] && [ "$MODE" != "kiosk" ]; then
    die "this image already had kiosk applied, which removed the desktop shell. Mode '$MODE' cannot be activated on top of it: the packages are gone from the layer below and no configuration change brings them back. Build this recipe from the base image instead."
fi

# ── release whatever the previous mode installed ─────────────────────────────────────────────────
auros_uninstall_previous "$AUROS_POLICY_MANIFEST"
auros_unmask_previous
auros_pam_su_release
auros_dconf_clear
auros_kdeglobals_strip "$AUROS_KDEGLOBALS"

install -m 0644 /dev/null "$AUROS_POLICY_MANIFEST"

# ── things every mode gets, including open ───────────────────────────────────────────────────────
# The polkit canary actions and the aurosadmin group live here. The canaries MUST exist in open too:
# open is where org.auros.policy.control-deny is expected to return 0, and an assertion that cannot
# observe the permissive case cannot prove the restrictive one.
COMMON_MANIFEST="$AUROS_POLICY_STATE/common.manifest"
if [ ! -s "$COMMON_MANIFEST" ]; then
    install -m 0644 /dev/null "$COMMON_MANIFEST"
    auros_install_tree "$PAYLOAD/common/root" "$COMMON_MANIFEST"
else
    log "common policy payload already installed"
fi
auros_ensure_admin_group

# ── the mode's own files ─────────────────────────────────────────────────────────────────────────
auros_install_tree "$SRC/root" "$AUROS_POLICY_MANIFEST"
auros_kdeglobals_apply "$SRC/kdeglobals"

# Modes are shipped as file trees, which means a mode bug is a file with the wrong mode bits, and a
# sudoers file with the wrong mode bits is a sudoers file sudo ignores -- silently. Fix and verify.
for f in /etc/sudoers.d/90-auros-*; do
    [ -e "$f" ] || continue
    chmod 0440 "$f"
    chown root:root "$f"
done
if command -v visudo >/dev/null 2>&1; then
    for f in /etc/sudoers.d/90-auros-*; do
        [ -e "$f" ] || continue
        visudo -cf "$f" >/dev/null || die "$f is not valid sudoers syntax -- refusing to build. An invalid file in sudoers.d can break sudo for everyone, including recovery."
        log "validated $f with visudo"
    done
else
    warn "visudo is not available; the sudoers drop-in was installed without syntax validation"
fi
for f in /usr/libexec/auros/auros-kiosk-session /usr/libexec/auros/apply-policy /usr/libexec/auros/assert-policy; do
    { [ -e "$f" ] && chmod 0755 "$f"; } || true
done

AUROS_GROUPS_STILL_MARKED=""
# NOT mktemp. Both of this script's scratch files live under $AUROS_POLICY_STATE, for a reason that
# is a build-determinism bug rather than tidiness:
#
#   apply-policy for kiosk runs in a CUSTOMER RECIPE's layer, where build/90-cleanup.sh has already
#   run and will not run again -- so nothing sweeps /tmp afterwards. A `mktemp` file that is not
#   removed is therefore COMMITTED INTO THE IMAGE with a random name per build, and two builds of
#   the same recipe against the same pinned base digest produce different content digests. That is
#   precisely the property check S7 gates on, and the failure presents as flakiness, which is how it
#   would get retried away instead of fixed.
#
#   $AUROS_POLICY_STATE is swept by the `find ... -exec touch` at the end of this script, so even a
#   file left behind by a `die` in the middle has a fixed name and a normalised mtime. Both are also
#   removed explicitly below.
AUROS_REMOVED_TSV="$AUROS_POLICY_STATE/.removed.tsv"
AUROS_KEEP_PRESENT_BEFORE="$AUROS_POLICY_STATE/.keep-present-before"
export AUROS_KEEP_PRESENT_BEFORE
: > "$AUROS_REMOVED_TSV"
: > "$AUROS_KEEP_PRESENT_BEFORE"
USR_BEFORE=0; USR_AFTER=0
COMPOSITOR=""

case "$MODE" in
  open)
    log "open: no restrictions are installed. The base image's hardening, the signed update path and"
    log "open: the retained rollback deployment are untouched -- open means we added no lock on top,"
    log "open: not that the floor was removed."
    rm -f "$AUROS_POLICY_STATE/kiosk-compositor" "$AUROS_POLICY_STATE/kiosk-vt-switch"
    ;;

  managed|locked)
    auros_dconf_profile
    auros_dconf_update
    auros_pam_su_restrict
    auros_unit_enable bootc-fetch-apply-updates.timer
    auros_unit_disable debug-shell.service
    auros_unit_mask debug-shell.service
    log "$MODE: polkit rules, sudoers, KDE Kiosk restrictions and dconf locks are in place."
    log "$MODE: none of that is evidence. /usr/libexec/auros/assert-policy is the evidence, and the"
    log "$MODE: check matrix runs it inside a booted VM (check B5)."
    ;;

  kiosk)
    # ---- 1. the application, decided before anything is deleted --------------------------------
    KIOSK_EXEC="${AUROS_KIOSK_EXEC:-}"
    if [ -z "$KIOSK_EXEC" ] && [ -r /etc/auros/kiosk.conf ]; then
        # shellcheck source=/dev/null
        . /etc/auros/kiosk.conf
    fi
    [ -n "${KIOSK_EXEC:-}" ] || die "kiosk mode needs an application. Pass AUROS_KIOSK_EXEC='...' or ship /etc/auros/kiosk.conf with KIOSK_EXEC set. A kiosk image with no application named is a machine that boots to a black screen, and it would pass every check that only looks at what was removed."
    install -d -m 0755 /etc/auros
    { printf '# Written by apply-policy. See kiosk.conf.example for the format.\n'
      printf 'KIOSK_EXEC=%s\n' "\"$KIOSK_EXEC\""; } > /etc/auros/kiosk.conf
    chmod 0644 /etc/auros/kiosk.conf
    printf '/etc/auros/kiosk.conf\n' >> "$AUROS_POLICY_MANIFEST"
    log "kiosk application: $KIOSK_EXEC"

    # ---- 2. a compositor, installed BEFORE the desktop is removed ------------------------------
    # Order matters: if the compositor cannot be installed we must fail while the image is still
    # usable, not after the desktop has been deleted.
    DNF="$(auros_pkgmgr)"
    if command -v cage >/dev/null 2>&1; then
        COMPOSITOR=cage
    elif [ "$DNF" != none ] && "$DNF" -y install --setopt=install_weak_deps=False cage >/dev/null 2>&1; then
        COMPOSITOR=cage
    elif command -v weston >/dev/null 2>&1 || { [ "$DNF" != none ] && "$DNF" -y install --setopt=install_weak_deps=False weston >/dev/null 2>&1; }; then
        # THE WESTON FALLBACK IS NOW OPT-IN, and the reason is a customer-facing claim rather than a
        # preference. kiosk/description.md tells the buyer "Ctrl+Alt+F2 does not produce a text
        # prompt". On the cage path that is enforced twice -- the gettys are masked AND cage is
        # started without `-s`, so the compositor never binds Ctrl+Alt+Fn at all. libweston's DRM
        # backend binds VT switching UNCONDITIONALLY; there is no flag to omit. The promise still
        # holds, because every getty is masked and a switch lands on a blank console, but it holds
        # by one mechanism instead of two, and that is a weaker image than the one we sold.
        #
        # So the build stops and makes a human decide, rather than silently shipping the weaker
        # machine when cage happens to be missing from the repositories that morning.
        if [ "${AUROS_KIOSK_ALLOW_WESTON:-0}" = 1 ]; then
            COMPOSITOR=weston
            warn "================================================================"
            warn "WESTON FALLBACK ACCEPTED (AUROS_KIOSK_ALLOW_WESTON=1)."
            warn "libweston binds VT switching unconditionally, so Ctrl+Alt+Fn DOES leave the"
            warn "compositor on this image. It lands on a blank console because every getty is"
            warn "masked -- not because the switch was prevented. kiosk/assert.sh records this as a"
            warn "known limit at runtime and kiosk/description.md states it to the customer."
            warn "================================================================"
        else
            die "kiosk: cage could not be installed and only weston is available.
weston is a WEAKER kiosk than cage for this product's central claim. cage is started without \`-s\`
so it never binds Ctrl+Alt+Fn; libweston's DRM backend binds VT switching unconditionally and has no
flag to turn it off. kiosk/description.md tells the customer 'Ctrl+Alt+F2 does not produce a text
prompt' -- which stays true either way, because every getty is masked, but on the weston path it is
true for one reason instead of two.
Refusing to make that trade silently. Either fix the cage availability, or set
AUROS_KIOSK_ALLOW_WESTON=1 to accept it deliberately; the runtime assertion and the customer-facing
description both record the limit when you do."
        fi
    else
        die "kiosk needs a Wayland kiosk compositor and neither cage nor weston could be installed. Refusing to delete the desktop shell from an image that would then have nothing to draw with."
    fi
    printf '%s\n' "$COMPOSITOR" > "$AUROS_POLICY_STATE/kiosk-compositor"
    # The VT-switch posture, recorded as a fact about THIS image so that kiosk/assert.sh asserts the
    # right thing rather than inferring it. assert.sh then checks the running compositor's own argv
    # against this record -- the record alone would be a configuration file, which is what B5 fails.
    case "$COMPOSITOR" in
        cage)   printf 'cage-no-vt-switch\n'         > "$AUROS_POLICY_STATE/kiosk-vt-switch" ;;
        weston) printf 'weston-vt-switch-possible\n' > "$AUROS_POLICY_STATE/kiosk-vt-switch" ;;
    esac
    log "kiosk compositor: $COMPOSITOR (recorded at $AUROS_POLICY_STATE/kiosk-compositor; assert.sh checks the RUNNING process against this)"
    log "kiosk VT posture: $(cat "$AUROS_POLICY_STATE/kiosk-vt-switch")"

    # DELIBERATELY NOT greetd. greetd is a login/display manager by function, and check S9 asserts
    # that no display-manager binary exists on a kiosk image. We would rather have no such binary at
    # all than ship one and then argue about whether it counts. systemd starts the compositor
    # directly; there is no greeter because there is nobody to greet.

    # ---- 3. measure, then subtract --------------------------------------------------------------
    USR_BEFORE="$(du -sxb /usr 2>/dev/null | cut -f1 || echo 0)"
    auros_snapshot_keep "$SRC/keep.list" "$AUROS_KEEP_PRESENT_BEFORE"
    auros_remove_packages "$SRC/remove.list" "$SRC/keep.list"
    auros_unmark_groups "$SRC/remove-groups.list"
    USR_AFTER="$(du -sxb /usr 2>/dev/null | cut -f1 || echo 0)"

    # ---- 4. the post-condition that is not an opinion -------------------------------------------
    MISSING_OK=1
    SURVIVING=""
    while IFS= read -r b; do
        [ -n "$b" ] || continue
        if command -v "$b" >/dev/null 2>&1 || [ -x "/usr/bin/$b" ] || [ -x "/usr/sbin/$b" ] || [ -x "/usr/libexec/$b" ]; then
            SURVIVING="${SURVIVING:+$SURVIVING }$b"
            MISSING_OK=0
        fi
    done < <(auros_read_list "$SRC/absent-binaries.list")
    if [ "$MISSING_OK" != 1 ]; then
        die "kiosk post-condition FAILED: these binaries are still on the image: $SURVIVING
This is exactly the failure D12 and check S9 exist to catch -- a kiosk image with a desktop inside
it. Do not work around it by editing absent-binaries.list. Find which package now provides the
binary, add it to remove.list, and let the build go red until it is gone."
    fi
    log "kiosk post-condition: every binary in absent-binaries.list is absent"

    # ---- 5. no console, no greeter, no way to a second session ----------------------------------
    auros_unit_mask 'getty@.service'
    auros_unit_mask 'serial-getty@.service'
    auros_unit_mask 'debug-shell.service'
    auros_unit_mask 'display-manager.service'
    auros_unit_mask 'sddm.service'
    auros_unit_mask 'gdm.service'
    install -d -m 0755 /etc/systemd/system
    ln -sf /usr/lib/systemd/system/multi-user.target /etc/systemd/system/default.target
    printf '/etc/systemd/system/default.target\n' >> "$AUROS_POLICY_MANIFEST"
    log "default target set to multi-user.target (there is no display manager to reach graphical.target for)"

    auros_dconf_profile
    auros_dconf_update
    auros_pam_su_restrict
    auros_unit_enable auros-kiosk.service
    auros_unit_enable bootc-fetch-apply-updates.timer

    # ---- 6. accounts ----------------------------------------------------------------------------
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers >/dev/null 2>&1 || warn "systemd-sysusers returned non-zero; the auroskiosk account will be created on first boot instead"
    fi
    ;;
esac

if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers >/dev/null 2>&1 || true
fi

# ── the stamp ────────────────────────────────────────────────────────────────────────────────────
# In /usr, not /etc: a runtime user cannot forge it, and the assertion script reads it to decide
# which mode it is supposed to be proving.
install -d -m 0755 "$AUROS_STATE_DIR"
printf '%s\n' "$MODE" > "$AUROS_MODE_STAMP"
chmod 0444 "$AUROS_MODE_STAMP"

# ── what this image CLAIMS, for the checks that are written against `open` ───────────────────────
#
# Spec 6A says the four modes are "declarative and switchable per-recipe", and a recipe selects one
# with a single RUN line. That was true of the FILES and not of the CHECKS: B1 ("reaches a login
# prompt") and B12 ("installing an application, connecting to Wi-Fi, adding a printer and changing
# the language are each reachable through the GUI") are written against what an open image does, and
# the publish gate requires every check for every digest with no per-mode clause. Kiosk has no login
# prompt by design and locked deliberately removes three of B12's four tasks from the seat -- so
# three of the four modes could never record a pass, and the subtraction product we sell had no path
# to a customer.
#
# The fix has two halves and this is the half that lives here: every mode declares its own criteria
# in its mode.env, and the ACTIVE mode's declaration is written to one canonical, machine-readable
# file on the read-only /usr, where the runtime checks read it. /usr/libexec/auros/assert-zero-terminal
# (check B12) reads this file and evaluates each task against what the mode claims, asserting
# absence where the mode claims `none` -- so the check can still go red, in both directions.
#
# The other half belongs to the matrix harness and the publish gate, which are not this directory's
# files. See policy/README.md, "Cross-layer assumptions", for the exact clause they need.
{
    printf '# Written by apply-policy at image build time. Read by the runtime checks.\n'
    printf '# Source of truth: /usr/share/auros/policy/%s/mode.env. Do not edit here.\n' "$MODE"
    printf 'AUROS_MODE=%s\n'                   "$MODE"
    printf 'AUROS_MODE_B1=%s\n'                "${AUROS_MODE_B1:-login-prompt}"
    printf 'AUROS_MODE_B12_INSTALL_APP=%s\n'   "${AUROS_MODE_B12_INSTALL_APP:-seat}"
    printf 'AUROS_MODE_B12_WIFI=%s\n'          "${AUROS_MODE_B12_WIFI:-seat}"
    printf 'AUROS_MODE_B12_PRINTER=%s\n'       "${AUROS_MODE_B12_PRINTER:-seat}"
    printf 'AUROS_MODE_B12_LANGUAGE=%s\n'      "${AUROS_MODE_B12_LANGUAGE:-seat}"
    printf 'AUROS_MODE_B12_DESKTOP=%s\n'       "${AUROS_MODE_B12_DESKTOP:-yes}"
} > "$AUROS_POLICY_STATE/claims.env"
chmod 0444 "$AUROS_POLICY_STATE/claims.env"
log "claims recorded at $AUROS_POLICY_STATE/claims.env (B1=$AUROS_MODE_B1, B12 install=$AUROS_MODE_B12_INSTALL_APP wifi=$AUROS_MODE_B12_WIFI printer=$AUROS_MODE_B12_PRINTER language=$AUROS_MODE_B12_LANGUAGE)"

# ── the report ───────────────────────────────────────────────────────────────────────────────────
{
    printf '{\n'
    printf '  "$comment": "Written by apply-policy at image build time. Sizes are MEASURED on-disk bytes under /usr, uncompressed. They are NOT pull size -- pull size is measured separately and lands in results.json as pull_size_delta_bytes (DECISIONS.md D2, D12).",\n'
    printf '  "mode": "%s",\n' "$(auros_json_str "$MODE")"
    printf '  "previous_mode": "%s",\n' "$(auros_json_str "$PREV")"
    printf '  "title": "%s",\n' "$(auros_json_str "$AUROS_MODE_TITLE")"
    # NOT `date`. Check S7 builds the image twice in one CI run and compares content digests, so a
    # wall-clock timestamp here would be the single field that makes two identical builds differ --
    # exactly the reason build/00-common.sh keeps timestamps out of build-steps.tsv. SOURCE_DATE_EPOCH
    # is set by the Containerfile from the upstream base image's creation time.
    printf '  "applied_at": "%s",\n' "$(date -u -d "@${SOURCE_DATE_EPOCH:-0}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
    printf '  "admin_group": "aurosadmin",\n'
    printf '  "admin_group_members": "%s",\n' "$(auros_json_str "$(getent group aurosadmin | cut -d: -f4)")"
    printf '  "kiosk_compositor": "%s",\n' "$(auros_json_str "$COMPOSITOR")"
    printf '  "kiosk_vt_switch": "%s",\n' "$(auros_json_str "$([ -r "$AUROS_POLICY_STATE/kiosk-vt-switch" ] && cat "$AUROS_POLICY_STATE/kiosk-vt-switch" || echo "")")"
    printf '  "claims": {"B1": "%s", "B12_install_app": "%s", "B12_wifi": "%s", "B12_printer": "%s", "B12_language": "%s", "B12_desktop": "%s"},\n' \
           "$(auros_json_str "${AUROS_MODE_B1:-}")" \
           "$(auros_json_str "${AUROS_MODE_B12_INSTALL_APP:-}")" \
           "$(auros_json_str "${AUROS_MODE_B12_WIFI:-}")" \
           "$(auros_json_str "${AUROS_MODE_B12_PRINTER:-}")" \
           "$(auros_json_str "${AUROS_MODE_B12_LANGUAGE:-}")" \
           "$(auros_json_str "${AUROS_MODE_B12_DESKTOP:-}")"
    printf '  "usr_bytes_before": %s,\n' "${USR_BEFORE:-0}"
    printf '  "usr_bytes_after": %s,\n' "${USR_AFTER:-0}"
    printf '  "usr_bytes_reclaimed": %s,\n' "$(( ${USR_BEFORE:-0} - ${USR_AFTER:-0} ))"
    printf '  "comps_groups_still_marked": "%s",\n' "$(auros_json_str "${AUROS_GROUPS_STILL_MARKED:-}")"
    printf '  "packages_removed": [\n'
    first=1
    while IFS=$'\t' read -r name bytes mech; do
        [ -n "$name" ] || continue
        [ "$first" = 1 ] || printf ',\n'
        first=0
        printf '    {"name": "%s", "installed_size_bytes": %s, "mechanism": "%s"}' \
               "$(auros_json_str "$name")" "${bytes:-0}" "$(auros_json_str "${mech:-unknown}")"
    done < "$AUROS_REMOVED_TSV"
    [ "$first" = 1 ] || printf '\n'
    printf '  ]\n'
    printf '}\n'
} > "$AUROS_REPORT"
chmod 0444 "$AUROS_REPORT"
# BOTH scratch files, not one. The keep-list snapshot used to be a `mktemp` that nothing removed,
# and in a recipe layer (where 90-cleanup.sh no longer runs) that put a /tmp/tmp.XXXXXXXXXX with a
# per-build random name inside every kiosk image -- breaking S7's "same recipe + same pinned base
# digest => same content digest" in a way that looks like flakiness.
rm -f "$AUROS_REMOVED_TSV" "$AUROS_KEEP_PRESENT_BEFORE"

# ── determinism: normalise the mtimes of everything this script wrote ────────────────────────────
#
# Check S7 builds the image twice in one CI run and requires the same content digest. A layer's
# digest covers mtimes, so a file created by `printf` at build time carries the wall clock and two
# identical builds differ. build/90-cleanup.sh normalises the paths that went through 00-common.sh's
# install_file(); nothing here goes through it, and when a RECIPE calls apply-policy, 90-cleanup has
# already run and will not run again. So this layer normalises its own.
_auros_epoch="${SOURCE_DATE_EPOCH:-0}"
LIBEXEC_APPLY=/usr/libexec/auros/apply-policy
LIBEXEC_ASSERT=/usr/libexec/auros/assert-policy
while IFS= read -r _p; do
    [ -n "$_p" ] && [ -e "$_p" ] && touch -h -d "@$_auros_epoch" "$_p" 2>/dev/null || true
    # Register with 00-common.sh's list too when it still exists, so 90-cleanup.sh sees these paths
    # as well. Belt and braces: whichever of the two runs, the mtimes end up the same.
    # `|| true` is load-bearing: under `set -e`, an AND-list whose last command does not run is a
    # failed simple command, and this script would abort on the first iteration in a recipe layer,
    # where AUROS_WRITTEN_LIST does not exist.
    { [ -n "${AUROS_WRITTEN_LIST:-}" ] && [ -f "${AUROS_WRITTEN_LIST}" ] && printf '%s\n' "$_p" >> "$AUROS_WRITTEN_LIST"; } || true
done < <(cat "$AUROS_POLICY_MANIFEST" "$COMMON_MANIFEST" 2>/dev/null; printf '%s\n' \
    "$AUROS_MODE_STAMP" "$AUROS_REPORT" "$AUROS_POLICY_MANIFEST" "$AUROS_MASKED_UNITS" \
    "$COMMON_MANIFEST" "$AUROS_KDEGLOBALS" "$AUROS_POLICY_STATE/kiosk-compositor" \
    "$AUROS_POLICY_STATE/kiosk-vt-switch" "$AUROS_POLICY_STATE/claims.env")
# Narrowed to the paths this layer owns. /usr/libexec/auros and /usr/lib/auros are shared with the
# update and hardening layers, and normalising another layer's mtimes would be harmless but is still
# reaching into somebody else's files.
find /usr/share/auros/policy "$AUROS_POLICY_STATE" \
     "$LIBEXEC_APPLY" "$LIBEXEC_ASSERT" "$AUROS_MODE_STAMP" \
     -exec touch -h -d "@$_auros_epoch" {} + 2>/dev/null || true
log "normalised mtimes to SOURCE_DATE_EPOCH=$_auros_epoch (check S7 builds twice and compares digests)"

log "----------------------------------------------------------------"
log "policy mode '$MODE' applied."
log "  files installed:   $(wc -l < "$AUROS_POLICY_MANIFEST" | tr -d ' ')"
log "  units masked:      $(wc -l < "$AUROS_MASKED_UNITS" | tr -d ' ')"
if [ "$MODE" = kiosk ]; then
