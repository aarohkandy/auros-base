#!/usr/bin/bash
#
# auros-update -- the ExecStart of bootc-fetch-apply-updates.service on Auros.
#
# Contract (spec 6A): "pulls on boot, stages, keeps the previous image on disk, rolls back
# automatically if the new image fails to reach a login prompt twice."
#
# This script owns the first three clauses. greenboot + the GRUB boot counter own the fourth.
#
# THE RULE
#   Always fetch and stage.
#   Reboot into the staged image only when nobody is using the machine.
#
# "Using the machine" means logind reports an Active session whose Class is `user`. The display
# manager's own greeter is Class=greeter and does NOT count -- if it did, a laptop sitting at the
# login screen would never update, which is most laptops most of the time, and check U1 (which
# runs against a VM sitting at exactly that greeter) would never pass.
#
# Failure policy: registry unreachable, or another updater holding the bootc lock, exits 0. U5
# says an offline machine must be a no-op, not a breakage, and a non-zero exit here becomes a
# failed unit, which 40-no-new-failed-units.sh would then read as a regression and roll the
# machine back because the school's uplink blinked.
#
# EXITING 0 IS NOT THE SAME AS SUCCEEDING, and the difference has to be recorded somewhere a
# human can find it, or "this machine stopped being patched" is indistinguishable from "this
# machine had nothing to do". The whole signal is three files in /var/lib/auros/update-agent:
#
#   last-fetch-attempt      written on EVERY run, success or failure
#   last-successful-fetch   written ONLY after `bootc upgrade` returned 0
#   last-error              written on failure, REMOVED on success
#
# 70-update-freshness.sh reads them and puts the answer in the boot-status motd. The only exit
# that is genuinely non-zero is "bootc is not installed", below: a machine that cannot update
# itself at all is not a transient condition and must not be reported as one.

set -euo pipefail

STATE_DIR=/var/lib/auros/update-agent
CONF_DIR=/etc/auros/update-agent
APPLY_POLICY_FILE="${CONF_DIR}/apply-policy"
LOCK_RETRY_SECONDS=60

log()  { printf '%s\n' "auros-update: $*"; }
warn() { printf '<4>%s\n' "auros-update: $*" >&2; }
err()  { printf '<3>%s\n' "auros-update: $*" >&2; }

mkdir -p "${STATE_DIR}"

# ---------------------------------------------------------------------------------------------
# 0. Preconditions
# ---------------------------------------------------------------------------------------------
if ! command -v bootc >/dev/null 2>&1; then
    err "bootc is not installed. This machine cannot update itself. Refusing to pretend otherwise."
    exit 1
fi

# ---------------------------------------------------------------------------------------------
# 1. Apply policy
# ---------------------------------------------------------------------------------------------
# when-idle : stage always, reboot only when no user session is active   (default, shipped)
# never     : stage always, never reboot on our own. For a fleet whose reboots the console drives.
# always    : stage and reboot unconditionally. Servers and kiosks with no interactive user.
apply_policy=when-idle
if [[ -r "${APPLY_POLICY_FILE}" ]]; then
    read -r apply_policy < "${APPLY_POLICY_FILE}" || apply_policy=when-idle
    apply_policy="${apply_policy//[[:space:]]/}"
fi

# The check-matrix harness boots its VMs with autologin, so there is always an Active, Class=user
# session and `when-idle` would correctly decline to reboot -- which reads as a U1 failure. The
# harness already overlays two HARNESS ONLY files onto the guest (registries.conf and a compressed
# timer interval); this marker is a third of the same kind. It is under /run, so it cannot exist on
# a machine that was not deliberately put into test mode, and it never ships.
if [[ -e /run/auros-check-matrix ]]; then
    log "/run/auros-check-matrix present: check-matrix run, applying unconditionally"
    apply_policy=always
fi
case "${apply_policy}" in
    when-idle|never|always) ;;
    *)
        warn "unrecognised apply-policy '${apply_policy}' in ${APPLY_POLICY_FILE}; using when-idle"
        apply_policy=when-idle
        ;;
esac

# ---------------------------------------------------------------------------------------------
# 2. Is a human using this machine?
# ---------------------------------------------------------------------------------------------
# Conservative by construction: anything we cannot determine is treated as "yes, someone is
# here". The cost of a wrong "no" is rebooting a child mid-sentence. The cost of a wrong "yes"
# is that the update lands at the next boot instead of this minute.
machine_in_use() {
    command -v loginctl >/dev/null 2>&1 || { warn "loginctl missing; assuming in use"; return 0; }

    local sessions session active class
    if ! sessions="$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}')"; then
        warn "could not enumerate sessions; assuming in use"
        return 0
    fi
    [[ -z "${sessions}" ]] && return 1

    while read -r session; do
        [[ -z "${session}" ]] && continue
        active="$(loginctl show-session "${session}" -p Active --value 2>/dev/null || echo unknown)"
        class="$(loginctl show-session "${session}"  -p Class  --value 2>/dev/null || echo unknown)"
        if [[ "${active}" == "unknown" || "${class}" == "unknown" ]]; then
            warn "session ${session}: state unreadable; assuming in use"
            return 0
        fi
        # greeter  = the login screen, nobody is logged in
        # lock-screen = a locked session; someone IS logged in, their apps are open. In use.
        if [[ "${active}" == "yes" && "${class}" == "user" ]]; then
            log "session ${session} is an active user session"
            return 0
        fi
    done <<< "${sessions}"

    return 1
}

# ---------------------------------------------------------------------------------------------
# 3. Fetch and stage
# ---------------------------------------------------------------------------------------------
bootc_json() { bootc status --json 2>/dev/null; }

json_get() {
    # json_get <jq-ish dotted path>   -- python3 so we do not depend on jq being in the image
    python3 -c '
import json,sys
d=json.load(sys.stdin)
for k in sys.argv[1].split("."):
    if d is None: break
    d = d.get(k) if isinstance(d, dict) else None
print("" if d is None else (d if isinstance(d,str) else json.dumps(d)))
' "$1" 2>/dev/null || printf ''
}

# `|| true` is not decoration. `bootc_json` propagates bootc's exit status, `json_get` swallows
# its own, and under `set -o pipefail` a transient `bootc status` failure makes the pipeline
# non-zero -- which makes the command substitution non-zero -- which makes `set -e` abort this
# script before ANY of the error handling below runs, producing exactly the failed unit that the
# service drop-in says must never happen. Measured:
#     $ bash -c 'set -euo pipefail; f(){ return 3;}; g(){ cat;}; x="$(f|g)"; echo unreachable'
#     exit=3, "unreachable" never printed.
# An unreadable `bootc status` must degrade to "unknown", not to a dead unit.
booted_digest_before="$(bootc_json | json_get status.booted.image.imageDigest || true)"
log "booted digest before: ${booted_digest_before:-unknown}"

stage_attempt() {
    # `bootc upgrade` without --apply fetches and stages. It does not reboot.
    bootc upgrade --quiet
}

# ---------------------------------------------------------------------------------------------
# HOW THE STATUS IS CAPTURED, and why it is not an `if !`
# ---------------------------------------------------------------------------------------------
# This block used to read:
#
#     if ! upgrade_out="$(stage_attempt 2>&1)"; then upgrade_rc=$?; ...
#
# `$?` there is the status of the NEGATED compound, which is 0 precisely WHEN THE COMMAND FAILED.
# Measured, this machine, GNU bash 3.2.57 and identical under 5.x:
#
#     $ f(){ return 7; }; rc=0; if ! out="$(f)"; then rc=$?; fi; echo $rc   ->  0
#     $ f(){ return 7; }; rc=0; out="$(f)" || rc=$?;            echo $rc   ->  7
#
# So `upgrade_rc` was 0 on every path, the offline/error branch below was unreachable dead code,
# and a registry outage, an HTTP 500, a corrupt manifest and a REJECTED SIGNATURE all fell through
# to the success path -- deleting last-error and writing a fresh last-successful-fetch stamp
# immediately after printing the rejection. 70-update-freshness.sh is the only mechanism in the
# design that notices a machine which has quietly stopped being patched, and its stamp was
# refreshed on every timer run regardless of outcome, so it could never fire. A laptop that had
# refused every update for two years reported "last successful update fetch was 0 day(s) ago".
#
# D19, verbatim: a step that cannot fail is not a check.
#
# Capture the status DIRECTLY. `x="$(cmd)" || rc=$?` reads the status of the command substitution
# itself, and the `||` also keeps `set -e` from aborting on the failure we are about to handle.
upgrade_rc=0
upgrade_out=""
upgrade_out="$(stage_attempt 2>&1)" || upgrade_rc=$?
if (( upgrade_rc != 0 )); then
    warn "first fetch attempt failed (rc=${upgrade_rc}); retrying in ${LOCK_RETRY_SECONDS}s"
    warn "${upgrade_out}"
    sleep "${LOCK_RETRY_SECONDS}"
    upgrade_rc=0
    upgrade_out="$(stage_attempt 2>&1)" || upgrade_rc=$?
fi
[[ -n "${upgrade_out}" ]] && printf '%s\n' "${upgrade_out}"

# Always stamped, success or failure. This is what distinguishes "this machine has never tried"
# from "this machine tries every six hours and is turned away every time" -- two states that
# looked identical before, and only one of which is a machine nobody has to drive out to.
date -uIseconds > "${STATE_DIR}/last-fetch-attempt"

if (( upgrade_rc != 0 )); then
    # Could not fetch. Offline (U5), or uupd.timer is holding the bootc lock -- Aurora ships
    # uupd.timer enabled at 04:00 and uupd also runs `bootc upgrade`; bootc serialises with its
    # own lock and the loser errors out. Neither is a fault of this machine's, and neither should
    # produce a failed unit. Leave a breadcrumb and exit clean.
    #
    # NOTE what is deliberately NOT done here: last-successful-fetch is not written and
    # last-error is not removed. Those two lines are the entire freshness signal.
    {
        printf 'timestamp=%s\n' "$(date -uIseconds)"
        printf 'rc=%s\n' "${upgrade_rc}"
        printf 'output<<EOF\n%s\nEOF\n' "${upgrade_out}"
    } > "${STATE_DIR}/last-error"
    # A single greppable token on the console, so a failed fetch is visible to the check matrix
    # from the serial log alone without a host->guest channel. See README, "What U5 must assert".
    err "AUROS-UPDATE-FETCH-FAILED rc=${upgrade_rc}"
    err "fetch failed (rc=${upgrade_rc}). Staying on the current image and retrying at the next timer run."
    exit 0
fi

rm -f "${STATE_DIR}/last-error"
date -uIseconds > "${STATE_DIR}/last-successful-fetch"
log "AUROS-UPDATE-FETCH-OK"

# ---------------------------------------------------------------------------------------------
# 4. Did anything actually stage?
# ---------------------------------------------------------------------------------------------
staged_digest="$(bootc_json | json_get status.staged.image.imageDigest || true)"
if [[ -z "${staged_digest}" ]]; then
    log "already up to date; nothing staged."
    exit 0
fi
log "staged: ${staged_digest}"
printf '%s\n' "${staged_digest}" > "${STATE_DIR}/staged-digest"

# ---------------------------------------------------------------------------------------------
# 5. Warn if this machine could not recover from a bad update
# ---------------------------------------------------------------------------------------------
# We do not refuse to stage on this basis. A machine that stops updating is the abandoned laptop
# we sell against, and refusing would trade a recoverable risk for a certain one. But the
# operator should be able to find this line in the journal afterwards.
if [[ -r /boot/grub2/grub.cfg ]] && ! grep -q 'boot_counter' /boot/grub2/grub.cfg; then
    err "ROLLBACK IS NOT WIRED: /boot/grub2/grub.cfg has no boot_counter logic."
    err "Staging anyway, but a failed update on this machine will NOT roll back by itself."
fi

# ---------------------------------------------------------------------------------------------
# 6. Apply, or wait for the next boot
# ---------------------------------------------------------------------------------------------
case "${apply_policy}" in
    never)
        log "apply-policy=never: staged and leaving it. It becomes active at the next boot."
        exit 0
        ;;
    when-idle)
        if machine_in_use; then
            log "someone is using this machine. Staged and leaving it; it becomes active at the next boot."
            exit 0
        fi
        log "no active user session."
        ;;
    always)
        log "apply-policy=always."
        ;;
esac

log "rebooting into ${staged_digest}"
# --apply on an already-staged deployment is the reboot. bootc is idempotent here: it will not
# re-fetch what it just staged.
exec bootc upgrade --apply --quiet
