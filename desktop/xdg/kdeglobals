# Auros — system-wide KDE defaults.  Installed to /etc/xdg/kdeglobals by build/40-windows-feel.sh.
#
# WHY /etc/xdg AND NOT /etc/skel:
#   KConfig cascades: every KConfig file is read from $XDG_CONFIG_DIRS (default /etc/xdg) first and the
#   user's own file is layered on top.  A value here therefore applies to EVERY user — including users
#   that already existed before this image was installed — and it keeps tracking the image as the image
#   is rebuilt nightly.  A copy dropped in /etc/skel is frozen at the moment the account was created and
#   never updates again.  Where cascading is unreliable we ship a skel copy as well; that is the
#   exception and it is named in desktop/README.md.
#
# A user can still change any of this in System Settings.  That is intentional: these are defaults, not
# a lockdown.  Lockdown is the policy layer's job (spec §6A, `locked` / `kiosk`), not this file's.

[KDE]
# THE ONE THAT MATTERS MOST.  KDE has historically opened files on a SINGLE click.  Every person coming
# off Windows double-clicks, which under single-click means they open the file twice — or drag it into a
# neighbouring folder by accident.  Plasma 6 changed the upstream default, but the upstream default is
# exactly the kind of thing that moves under a nightly rebuild, so we state it rather than inherit it.
SingleClick=false
LookAndFeelPackage=org.auros.windows.desktop
widgetStyle=Breeze
# Half-speed animations.  These machines are 2012-2018 with integrated graphics; the default duration
# reads as lag on GMA/HD-graphics-era hardware.  0 would disable animations entirely and makes window
# state changes hard to follow, which is worse for a novice.
AnimationDurationFactor=0.5
# Windows has "Delete" in the right-click menu.  KDE hides it behind Shift by default and offers only
# "Move to Trash".  Showing both matches the muscle memory without removing the safe option.
ShowDeleteCommand=true

[General]
ColorScheme=BreezeLight

[Icons]
Theme=breeze

[KFileDialog Settings]
Sort directories first=true
Show hidden files=false
