[Unit]
# Auros — installed to /usr/lib/systemd/user/auros-choose-password.service and enabled image-wide by a
# symlink in /usr/lib/systemd/user/graphical-session.target.wants/ (same reason as auros-first-run).
# man systemd.unit: %u is the name of the user running the service manager. The marker is root's, so
# once root removes it this unit never starts again for that account.
Description=Auros: choose your own password (once per account)
ConditionPathExists=/var/lib/auros/choose-password/%u
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/auros/auros-choose-password
# It waits for a person. auros-first-run.service is After= this, so it waits with it.
TimeoutStartSec=infinity

[Install]
WantedBy=graphical-session.target
