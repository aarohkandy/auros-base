[Unit]
# Auros — installed to /usr/lib/systemd/system/auros-password-chosen.service. Started by the .path unit.
Description=Auros: clear the choose-your-password step for accounts that have done it
ConditionDirectoryNotEmpty=/var/lib/auros/choose-password

[Service]
Type=oneshot
ExecStart=/usr/libexec/auros/auros-password-chosen
