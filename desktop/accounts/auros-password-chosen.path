[Unit]
# Auros — installed to /usr/lib/systemd/system/auros-password-chosen.path, enabled for multi-user.target.
# man systemd.path: PathChanged= activates the unit when the watched file is closed after a write or
# replaced; shadow-utils (chpasswd/usermod, which accountsservice runs) replaces /etc/shadow by rename.
Description=Auros: notice an account choosing its own password

[Path]
PathChanged=/etc/shadow
Unit=auros-password-chosen.service

[Install]
WantedBy=multi-user.target
