#!/usr/bin/env bash
# Auros — installed to /usr/libexec/auros/auros-password-chosen
# Run as root by auros-password-chosen.service, which auros-password-chosen.path starts whenever
# /etc/shadow changes. Control repo docs/ACCOUNTS.md §5.
#
# auros-accounts leaves /var/lib/auros/choose-password/<name> for every account whose first password
# came from the enrolment file (a password IT knows). The file holds the SHA-256 of the crypt(3) hash
# that was set, never the hash. While it exists, that person's first sign-in stops at "choose your
# password" (/usr/libexec/auros/auros-choose-password). It goes when, and only when, the hash in
# /etc/shadow is no longer the enrolled one: root-owned state the account cannot fake, because the only
# way to change it from the seat is to actually set a new password.
set -euo pipefail
PENDING=/var/lib/auros/choose-password

[ -d "$PENDING" ] || exit 0
for f in "$PENDING"/*; do
  [ -f "$f" ] || continue
  n="${f##*/}"
  h="$(getent shadow "$n" | cut -d: -f2)" || h=""
  if [ -z "$h" ]; then
    rm -f "$f"; echo "auros-password-chosen: $n no longer exists; nothing left to ask"
  elif [ "$(printf '%s' "$h" | sha256sum | cut -d' ' -f1)" != "$(cat "$f")" ]; then
    rm -f "$f"; echo "auros-password-chosen: $n has chosen their own password"
  fi
done
